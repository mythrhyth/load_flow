# Node runtime environment
NODE_ENV=production
PORT=3000

# SQLite database path (use file:/var/data/dev.db on Render persistent volume mount)
DATABASE_URL="file:./prisma/dev.db"

# Uploads directory path (use /var/data/uploads on Render persistent volume mount)
UPLOAD_PATH="../uploads"

# JWT Secret keys
JWT_SECRET="your-super-long-secure-jwt-secret-key"
JWT_REFRESH_SECRET="your-super-long-secure-jwt-refresh-secret-key"

# CORS configuration (comma separated list of allowed domains)
FRONTEND_URL="http://localhost:5173,https://loadflow-frontend.vercel.app"

# AI parsing service configuration (optional API key details)
AI_PROVIDER="openai"
AI_API_KEY=""
